---
import Page from "../layouts/page.astro";
import Pricing from "../components/pricing.tsx";
import Callout from "../components/callout.tsx";
import Button from "../components/button.tsx";
import Block from "../components/block.astro";
import { AcademicCapIcon, CheckIcon, CircleStackIcon, DocumentTextIcon, QuestionMarkCircleIcon } from "@heroicons/react/24/outline";
import { getBlockTitle } from "../lib/blocks";
import { site } from "../lib/site";

const { seo, heading, intro, documentation, howItWorks, offer, pricing } = site.researchSupport;
const { supportEmail } = site.contact;

const offerCards = [
    { ...offer.supportTypes, Icon: QuestionMarkCircleIcon },
    { ...offer.dataTypes, Icon: CircleStackIcon },
    { ...offer.fields, Icon: AcademicCapIcon },
];

const serviceAgreementTitle = await getBlockTitle("research-support-service-agreement");
---

<Page variant="wide" seo={seo}>

    <!-- Hero -->
    <div class="max-w-3xl">
        <p class="flex items-center gap-2 text-sm font-semibold text-marker-text tracking-wide uppercase"><span class="h-2 w-2 rounded-marker bg-marker" aria-hidden="true" />Research Support</p>
        <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-ink leading-[1.1]">
            {heading}
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-body max-w-2xl">
            {intro}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <Button href={`mailto:${supportEmail}`}>{supportEmail}</Button>
            <Button href={documentation.href} variant="link" external>{documentation.label}</Button>
        </div>
    </div>

    <!-- How it works -->
    <div class="mt-12">
        <Callout title={howItWorks.title} variant="info">
            {howItWorks.body}
        </Callout>
    </div>

    <!-- What we offer -->
    <section class="mt-16 lg:mt-20">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink">{offer.heading}</h2>
        <p class="mt-3 text-base leading-relaxed text-body max-w-2xl">{offer.intro}</p>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-5">
            {offerCards.map(({ title, items, Icon }) => (
                <div class="rounded-card border border-rule bg-surface p-5">
                    <div class="h-9 w-9 rounded-control border border-rule flex items-center justify-center mb-4">
                        <Icon className="h-5 w-5 text-ink" aria-hidden="true" />
                    </div>
                    <h3 class="text-base font-semibold text-ink">{title}</h3>
                    <ul class="mt-3 space-y-2">
                        {items.map(item => (
                            <li class="flex items-start gap-2 text-sm text-body">
                                <CheckIcon className="h-4 w-4 shrink-0 mt-0.5 text-accent" aria-hidden="true" />
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <!-- Support model -->
    <section class="mt-16 lg:mt-20">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink">Support model</h2>
        <Block slug="research-support-model" class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-body" />

        <!-- Service agreement -->
        <div class="mt-8 rounded-card border border-rule bg-surface p-5 max-w-3xl">
            <div class="flex items-center gap-3 mb-3">
                <DocumentTextIcon className="h-5 w-5 text-ink shrink-0" aria-hidden="true" />
                <h3 class="text-base font-semibold text-ink">{serviceAgreementTitle}</h3>
            </div>
            <Block slug="research-support-service-agreement" class="text-sm leading-relaxed text-body" />
        </div>
    </section>

    <!-- Pricing -->
    <section class="mt-16 lg:mt-20">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink">{pricing.heading}</h2>
        <p class="mt-3 text-base leading-relaxed text-body max-w-2xl">{pricing.intro}</p>

        <Pricing tiers={pricing.tiers} email={supportEmail} />
    </section>

</Page>
