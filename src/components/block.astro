---
import { render } from "astro:content";
import { getBlock } from "../lib/blocks";

interface Props {
    slug: string;
    class?: string;
}

const { slug, class: className } = Astro.props;
const { Content } = await render(await getBlock(slug));
---

{/* Not elements.tsx: its links all open in a new tab and its lists and headings are article-sized. */}
<div class:list={[className, "[&_a]:text-accent [&_a:hover]:underline [&_strong]:font-semibold [&_strong]:text-ink [&_em]:font-medium [&_em]:not-italic [&_em]:text-ink"]}>
    <Content />
</div>
